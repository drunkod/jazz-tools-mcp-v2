{
  "name": "jazz-tools-mcp-v2",
  "version": "0.1.0",
  "private": true,
  "description": "MVP MCP connector for the official jazz-tools@alpha self-hosted server",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "jazz-napi": "alpha",
    "jazz-tools": "alpha",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "bin": {
    "jazz-tools-mcp-v2": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    ".env.example",
    "LICENSE"
  ]
}
