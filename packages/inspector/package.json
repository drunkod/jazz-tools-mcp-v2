{
  "name": "inspector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "pnpm run typecheck && pnpm run build:direct && pnpm run build:embedded && pnpm run build:production",
    "build:direct": "vite build --mode direct",
    "build:embedded": "vite build --mode embedded",
    "build:production": "vite build --mode production",
    "build:vercel": "pnpm run typecheck && pnpm run build:production && pnpm run test:production-build",
    "preview:production": "vite preview --outDir dist",
    "test": "vitest run --config vitest.config.ts",
    "test:production-build": "node --test tests/build/production-build.test.mjs",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:browser:production": "pnpm run build:production && playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "jazz-tools": "alpha",
    "react": "^19.2.0",
    "react-data-grid": "7.0.0-beta.59",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.9.0",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/ui": "4.1.0",
    "happy-dom": "^20.8.4",
    "jsdom": "^28.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
