# Required: the official `npx jazz-tools@alpha server ...` instance.
JAZZ_SERVER_URL=http://127.0.0.1:1625
JAZZ_APP_ID=replace-with-your-app-id
JAZZ_ADMIN_SECRET=replace-with-admin-secret

# Optional: pin a published schema hash. Default: newest published schema.
# JAZZ_SCHEMA_HASH=

# Optional server/backend identity. When set, the connector uses backend-scoped
# access and can stamp writes with JAZZ_MCP_PRINCIPAL.
# JAZZ_BACKEND_SECRET=
# JAZZ_MCP_PRINCIPAL=mcp:agent

# Safe default: mutations are disabled.
JAZZ_MCP_ALLOW_WRITES=false

# Jazz durability tier for mutations: local | edge | global.
JAZZ_MCP_DURABILITY=edge

# Jazz namespace options.
JAZZ_ENV=dev
JAZZ_BRANCH=main
